/**pages/about/about.wxss**/
.container {
  width: 100%;
  min-height: 100vh;
  padding: 20rpx;
  background-color: #f6f6f6;
}

.about-box {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.item {
  margin-bottom: 20rpx;
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 4rpx;
}

.label {
  font-size: 24rpx;
  font-weight: bold;
  color: #1AAD19;
  display: inline-block;
  min-width: 100rpx;
}

.value {
  font-size: 24rpx;
  color: #666;
}

.btn {
  margin-top: 30rpx;
  background-color: #1AAD19;
  color: #fff;
}
